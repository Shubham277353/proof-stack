PORT=4000
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/proofstack"
# For providers that use a connection pooler (e.g. Neon, Supabase):
# DATABASE_URL points to the pooled endpoint, DIRECT_URL to the direct connection.
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/proofstack"
JWT_SECRET="<min-32-char-random-secret>"
JWT_EXPIRY="7d"
# Comma-separated list of allowed frontend origins (required in production)
# Example: CLIENT_URL=https://proofstack.example.com
CLIENT_URL=
