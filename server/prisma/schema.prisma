generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ClaimLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReviewRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  username     String?  @unique
  displayName  String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects       Project[]
  skillClaims    SkillClaim[]
  reviewRequests ReviewRequest[] @relation("Requester")
  reviewsGiven   ReviewRequest[] @relation("Reviewer")

  @@index([email])
  @@index([username])
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  repoUrl     String?
  liveUrl     String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId  String
  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([ownerId])
}

model Evidence {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String?
  fileKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  claimLinks ClaimEvidence[]

  @@index([projectId])
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?
  createdAt   DateTime @default(now())

  skillClaims SkillClaim[]

  @@index([name])
}

model SkillClaim {
  id          String      @id @default(uuid())
  level       ClaimLevel
  status      ClaimStatus @default(DRAFT)
  summary     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  evidenceLinks  ClaimEvidence[]
  reviewRequests ReviewRequest[]

  @@unique([userId, skillId, level])
  @@index([userId])
  @@index([skillId])
}

model ClaimEvidence {
  claimId    String
  evidenceId String
  addedAt    DateTime @default(now())

  claim    SkillClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([claimId, evidenceId])
}

model ReviewRequest {
  id          String              @id @default(uuid())
  status      ReviewRequestStatus @default(PENDING)
  message     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requesterId String
  requester   User       @relation("Requester", fields: [requesterId], references: [id])
  reviewerId  String
  reviewer    User       @relation("Reviewer", fields: [reviewerId], references: [id])
  claimId     String
  claim       SkillClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  review Review?

  @@index([requesterId])
  @@index([reviewerId])
  @@index([claimId])
}

model Review {
  id        String   @id @default(uuid())
  feedback  String
  // Scores 1–5: enforced in application layer
  scoreDepth       Int
  scoreClarity     Int
  scoreEvidence    Int
  scoreOverall     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewRequestId String        @unique
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)

  @@index([reviewRequestId])
}
